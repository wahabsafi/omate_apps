#. module: om_user_audit
#: model:mail.template,body_html:om_user_audit.mail_template_sign_in
msgid ""
""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p><t t-out=\"object.name or ''\"/> (<t t-out=\"object.login or ''\"/>) signed in to <t t-out=\"object.company_id.name or ''\"/>.</p>\n"
"<ul>\n"
"    <t t-set=\"not_available\">N/A</t>\n"
"    <li>When: <t t-out=\"ctx.get('om_date') and format_datetime(ctx.get('om_date'), tz=object.tz, dt_format='medium') or not_available\"/></li>\n"
"    <li>Where: <t t-out=\"ctx.get('om_place') or not_available\"/></li>\n"
"    <li>Address: <t t-out=\"ctx.get('om_ip') or not_available\"/></li>\n"
"    <li>Browser: <t t-out=\"ctx.get('om_agent') or not_available\"/></li>\n"
"</ul>\n"
"<p style=\"margin: 16px 0px 16px 0px;\">\n"
"    If this sign-in was not expected, change the password of this account and end its\n"
"    sessions from Settings.\n"
"</p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p><t t-out=\"object.name or ''\"/> (<t t-out=\"object.login or ''\"/>) وارد <t t-out=\"object.company_id.name or ''\"/> شد.</p>\n"
"<ul>\n"
"    <t t-set=\"not_available\">نامشخص</t>\n"
"    <li>زمان: <t t-out=\"ctx.get('om_date') and format_datetime(ctx.get('om_date'), tz=object.tz, dt_format='medium') or not_available\"/></li>\n"
"    <li>مکان: <t t-out=\"ctx.get('om_place') or not_available\"/></li>\n"
"    <li>آدرس IP: <t t-out=\"ctx.get('om_ip') or not_available\"/></li>\n"
"    <li>مرورگر: <t t-out=\"ctx.get('om_agent') or not_available\"/></li>\n"
"</ul>\n"
"<p style=\"margin: 16px 0px 16px 0px;\">\n"
"    اگر این ورود مورد انتظار شما نبود، رمز عبور این حساب را تغییر دهید و نشست‌های آن را\n"
"    از بخش تنظیمات پایان دهید.\n"
"</p>\n"
"</div>\n"
"        "

