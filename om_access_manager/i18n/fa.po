msgstr "+ افزودن یک شرط"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
""
", except what\n"
"                            the cards below limit."
msgstr ""
"، به‌جز مواردی که\n"
"                            کارت‌های زیر محدود می‌کنند."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
""
". Limit some only if\n"
"                            needed: pick the data below."
msgstr ""
". در صورت نیاز فقط برخی را\n"
"                            محدود کنید: داده‌های زیر را انتخاب نمایید."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ". Tick more apps or untick them."
msgstr ". برنامه‌های بیشتری را علامت بزنید یا علامت آن‌ها را بردارید."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/menu_tree/menu_tree_field.js:0
msgid "1 hidden"
msgstr "۱ پنهان"

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/wizard/om_access_explain.py:0
msgid "1. Odoo's own access"
msgstr "۱. دسترسی‌های خود اودو"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid "1st click"
msgstr "کلیک اول"

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/wizard/om_access_explain.py:0
msgid "2. Access profiles"
msgstr "۲. پروفایل‌های دسترسی"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid "2nd click"
msgstr "کلیک دوم"

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/wizard/om_access_explain.py:0
msgid "3. Also restricted on this data"
msgstr "۳. همچنین روی این داده‌ها محدود شده است"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid "3rd click"
msgstr "کلیک سوم"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ": as Odoo shows it."
msgstr ": همان‌طور که اودو نمایش می‌دهد."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
""
": not shown on the form, in lists or on cards, and blank in exports and "
"scripts."
msgstr ": در فرم، لیست‌ها یا کارت‌ها نمایش داده نمی‌شود، و در خروجی‌ها و اسکریپت‌ها خالی است."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
#: code:addons/om_access_manager/static/src/menu_tree/menu_panel.xml:0
msgid ": own filter"
msgstr ": فیلتر اختصاصی"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ": shown only in some states"
msgstr ": فقط در برخی وضعیت‌ها نشان داده می‌شود"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
""
": they see it but cannot change it, on the screens, by import or by a "
"script."
msgstr ": آن را می‌بینند اما نمی‌توانند آن را در صفحات، از طریق وارد کردن یا با اسکریپت تغییر دهند."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ": they see the button and can use it."
msgstr ": دکمه را می‌بینند و می‌توانند از آن استفاده کنند."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
""
": they will see almost no records. Set it on\n"
"                                each user (Preferences or the user form), or use Only some... with the Warehouse."
msgstr ""
": تقریباً هیچ رکوردی را نخواهند دید. آن را روی\n"
"                                هر کاربر (ترجیحات یا فرم کاربر) تنظیم کنید، یا از فقط برخی... با انبار استفاده نمایید."

#. module: om_access_manager
#: model_terms:ir.ui.view,arch_db:om_access_manager.om_access_profile_view_form
msgid ""
""
"<span class=\"text-muted\">\n"
"                                    The menus of the database. Untick a menu to hide it with\n"
"                                    everything below it; click a menu to decide what its users may\n"
"                                    do there. In developer mode, more tabs list the same rules in full.\n"
"                                </span>"
msgstr ""
"<span class=\"text-muted\">\n"
"                                    منوهای پایگاه داده. تیک یک منو را بردارید تا همراه با\n"
"                                    تمام موارد زیر آن پنهان شود؛ روی یک منو کلیک کنید تا مشخص نمایید کاربران آن چه کاری می‌توانند\n"
"                                    در آنجا انجام دهند. در حالت توسعه‌دهنده، زبانه‌های بیشتر همین قوانین را به صورت کامل فهرست می‌کنند.\n"
"                                </span>"

#. module: om_access_manager
#: model_terms:ir.ui.view,arch_db:om_access_manager.om_access_profile_view_form
msgid ""
""
"<span>The Health Check found rules of this profile that need a look.</span>"
msgstr "<span>بررسی سلامت قوانینی از این پروفایل را پیدا کرد که نیاز به بازبینی دارند.</span>"

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_profile_element.py:0
msgid "A '%s' rule needs a name."
msgstr "یک قانون '%s' به نام نیاز دارد."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_profile_element.py:0
msgid "A Settings App rule belongs to the Settings."
msgstr "یک قانون برنامه تنظیمات متعلق به تنظیمات است."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid ""
""
"A field marked 'may be slow on large data' has no database index: ask your "
"developer to add one if lists get slow."
msgstr "فیلدی که با 'ممکن است روی داده‌های حجیم کند باشد' مشخص شده، شاخص پایگاه داده ندارد: اگر لیست‌ها کند شدند، از توسعه‌دهنده خود بخواهید یکی اضافه کند."

#. module: om_access_manager
#: model_terms:ir.ui.view,arch_db:om_access_manager.om_access_import_view_form
msgid ""
""
"A file made with <strong>Export Profiles</strong> on another database. What\n"
"                    this database lacks (an app, a menu, a journal) is skipped and listed in the\n"
"                    chatter of the profile."
msgstr ""
"فایلی که با <strong>برون‌بری پروفایل‌ها</strong> در پایگاه داده دیگری ایجاد شده است. مواردی که\n"
"                    این پایگاه داده ندارد (یک برنامه، یک منو، یک دفترروزنامه) نادیده گرفته شده و در\n"
"                    بخش گفتگوی پروفایل فهرست می‌شود."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.js:0
msgid "A filter of its own"
msgstr "فیلتر اختصاصی خود"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid "A filter of its own is set (by operation or on a menu)."
msgstr "یک فیلتر اختصاصی تنظیم شده است (بر اساس عملیات یا روی یک منو)."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid "A filter on records also hides the new ones that do not match it."
msgstr "یک فیلتر روی رکوردها همچنین رکوردهای جدیدی را که با آن مطابقت ندارند پنهان می‌کند."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/menu_tree/menu_panel.xml:0
msgid ""
""
"A hidden app leaves the Settings, and what only it holds cannot be saved."
msgstr "یک برنامه پنهان از تنظیمات خارج می‌شود، و آنچه منحصراً شامل می‌شود قابل ذخیره نیست."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid ""
""
"A hidden field is blank for these users in lists, exports and the external "
"API too."
msgstr "یک فیلد پنهان برای این کاربران در لیست‌ها، برون‌بری‌ها و API خارجی نیز خالی است."

#. module: om_access_manager
#: model_terms:ir.ui.view,arch_db:om_access_manager.om_access_profile_view_form
msgid ""
""
"A hidden field is removed from the screen and is not fetched with\n"
"                                the record, but this is not a guarantee that its value cannot be\n"
"                                read: use a record filter for data that must not leak.\n"
"                                With a condition (<code>state == 'done'</code>,\n"
"                                <code>amount_total &gt; 1000</code>), the rule applies only to\n"
"                                the records that match it."
msgstr ""
"یک فیلد پنهان از روی صفحه حذف می‌شود و همراه با\n"
"                                رکورد واکشی نمی‌شود، اما این تضمینی بر غیرقابل خواندن بودن\n"
"                                مقدار آن نیست: برای داده‌هایی که نباید فاش شوند از فیلتر رکورد استفاده کنید.\n"
"                                با یک شرط (<code>state == 'done'</code>،\n"
"                                <code>amount_total &gt; 1000</code>)، قانون فقط روی\n"
"                                رکوردهایی اعمال می‌شود که با آن مطابقت دارند."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid "A menu with children passes its rights down to them."
msgstr "یک منو با زیرمنوها دسترسی‌های خود را به آن‌ها منتقل می‌کند."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid ""
""
"A new profile applies only from Finish. On a profile in use, each answer "
"applies at once."
msgstr "یک پروفایل جدید فقط پس از پایان اعمال می‌شود. در پروفایل در حال استفاده، هر پاسخ بلافاصله اعمال می‌گردد."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_preview.py:0
msgid "A preview needs a browser session."
msgstr "پیش‌نمایش به یک نشست مرورگر نیاز دارد."

#. module: om_access_manager
